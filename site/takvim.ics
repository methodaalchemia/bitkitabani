DTSTART;VALUE=DATE:20260506
DTEND;VALUE=DATE:20260507
RRULE:FREQ=YEARLY
SUMMARY:Hıdrellez
DESCRIPTION:Hızır ile İlyas’ın buluştuğu gün\; dilekler gül ağ
