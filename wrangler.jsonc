{
  // Bitki Tabanı: statik site (./site) + /api/* için küçük bir Worker (Google ile giriş, ilerleme saklama)
  "name": "bitkitabani",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/ig/*"]
  },
  "vars": {
    // Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Boşsa giriş kapalıdır.
    "GOOGLE_CLIENT_ID": "437365792568-00ajl9g880m3e2du0h952cvpvcgct9ks.apps.googleusercontent.com"
  },
  // Akıllı arama (/api/ara): Workers AI çok dilli gömme modeli
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "USERS", "class_name": "UserStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  // Instagram paylaşımı (IG_TOKEN gizli değişkeni gerekir): yarım saatte bir bakar. Açılış günü 12 post yarım saat arayla,
  // sonra her akşam 19:00'dan itibaren günde bir post; başarısız olursa yarım saat sonra yeniden dener.
  "triggers": { "crons": ["*/30 * * * *"] }
}
