{
  // Bitki Tabanı: statik site (./site) + /api/* için küçük bir Worker (Google ile giriş, ilerleme saklama)
  "name": "bitkitabani",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web). Boşsa giriş kapalıdır.
    "GOOGLE_CLIENT_ID": "437365792568-00ajl9g880m3e2du0h952cvpvcgct9ks.apps.googleusercontent.com"
  },
  "durable_objects": {
    "bindings": [{ "name": "USERS", "class_name": "UserStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }]
}
